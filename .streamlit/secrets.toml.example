# Streamlit Community Cloud 배포 시 사용하는 비밀 키 양식.
# 로컬 실행에는 .env를 쓰고, Streamlit Cloud에 배포할 때는
# 이 형식을 복사해서 대시보드의 "Secrets" 입력란에 붙여넣으세요.
#
# 실제 secrets.toml 파일은 .gitignore에 포함되어 있습니다.

# Gemini 무료 API 키 (https://aistudio.google.com/app/apikey 에서 무료 발급)
# 키가 없으면 앱은 자동으로 규칙기반 오프라인 모드로 동작합니다. (유료 API 미사용)
GEMINI_API_KEY = ""
